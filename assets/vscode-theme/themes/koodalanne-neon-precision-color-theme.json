{
  "$schema": "vscode://schemas/color-theme",
  "name": "koodalanne — Neon Precision",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "editor.background": "#111218",
    "editor.foreground": "#ececee",
    "editorLineNumber.foreground": "#3a3e4e",
    "editorLineNumber.activeForeground": "#f890e7",
    "editorCursor.foreground": "#f890e7",
    "editor.selectionBackground": "#f890e733",
    "editor.selectionHighlightBackground": "#0bd3d322",
    "editor.wordHighlightBackground": "#7a5cff22",
    "editor.findMatchBackground": "#0bd3d355",
    "editor.findMatchHighlightBackground": "#0bd3d322",
    "editor.lineHighlightBackground": "#181a23",
    "editorWhitespace.foreground": "#20222e",
    "editorIndentGuide.background1": "#20222e",
    "editorIndentGuide.activeBackground1": "#2a2d3a",
    "editorBracketMatch.background": "#0bd3d322",
    "editorBracketMatch.border": "#0bd3d3",
    "editorGutter.modifiedBackground": "#ffcf6a",
    "editorGutter.addedBackground": "#33e59b",
    "editorGutter.deletedBackground": "#ff5470",

    "editorWidget.background": "#181a23",
    "editorWidget.border": "#2a2d3a",
    "editorHoverWidget.background": "#181a23",
    "editorHoverWidget.border": "#2a2d3a",
    "editorSuggestWidget.background": "#181a23",
    "editorSuggestWidget.border": "#2a2d3a",
    "editorSuggestWidget.selectedBackground": "#20222e",
    "editorSuggestWidget.highlightForeground": "#f890e7",

    "activityBar.background": "#0c0d12",
    "activityBar.foreground": "#ececee",
    "activityBar.inactiveForeground": "#7a7a85",
    "activityBar.activeBorder": "#f890e7",
    "activityBarBadge.background": "#f890e7",
    "activityBarBadge.foreground": "#0c0d12",

    "sideBar.background": "#12131a",
    "sideBar.foreground": "#b4b4be",
    "sideBar.border": "#20222e",
    "sideBarSectionHeader.background": "#12131a",
    "sideBarTitle.foreground": "#7a7a85",
    "list.activeSelectionBackground": "#20222e",
    "list.activeSelectionForeground": "#ececee",
    "list.inactiveSelectionBackground": "#181a23",
    "list.hoverBackground": "#181a23",
    "list.highlightForeground": "#0bd3d3",
    "tree.indentGuidesStroke": "#2a2d3a",

    "statusBar.background": "#0c0d12",
    "statusBar.foreground": "#b4b4be",
    "statusBar.border": "#20222e",
    "statusBar.noFolderBackground": "#0c0d12",
    "statusBar.debuggingBackground": "#f890e7",
    "statusBar.debuggingForeground": "#0c0d12",
    "statusBarItem.remoteBackground": "#0bd3d3",
    "statusBarItem.remoteForeground": "#0c0d12",

    "titleBar.activeBackground": "#0c0d12",
    "titleBar.activeForeground": "#ececee",
    "titleBar.inactiveBackground": "#0c0d12",
    "titleBar.border": "#20222e",

    "tab.activeBackground": "#111218",
    "tab.inactiveBackground": "#0c0d12",
    "tab.activeForeground": "#ececee",
    "tab.inactiveForeground": "#7a7a85",
    "tab.activeBorderTop": "#f890e7",
    "tab.border": "#20222e",
    "editorGroupHeader.tabsBackground": "#0c0d12",
    "breadcrumb.foreground": "#7a7a85",
    "breadcrumb.focusForeground": "#0bd3d3",

    "panel.background": "#0c0d12",
    "panel.border": "#20222e",
    "panelTitle.activeForeground": "#ececee",
    "panelTitle.activeBorder": "#f890e7",

    "terminal.background": "#111218",
    "terminal.foreground": "#ececee",
    "terminalCursor.foreground": "#f890e7",
    "terminal.ansiBlack": "#0c0d12",
    "terminal.ansiRed": "#ff5470",
    "terminal.ansiGreen": "#33e59b",
    "terminal.ansiYellow": "#ffcf6a",
    "terminal.ansiBlue": "#7a5cff",
    "terminal.ansiMagenta": "#f890e7",
    "terminal.ansiCyan": "#0bd3d3",
    "terminal.ansiWhite": "#cfcfd6",
    "terminal.ansiBrightBlack": "#2a2d3a",
    "terminal.ansiBrightRed": "#ff8095",
    "terminal.ansiBrightGreen": "#5ff0b3",
    "terminal.ansiBrightYellow": "#ffdd8f",
    "terminal.ansiBrightBlue": "#9b83ff",
    "terminal.ansiBrightMagenta": "#faaeef",
    "terminal.ansiBrightCyan": "#5ee6e6",
    "terminal.ansiBrightWhite": "#ffffff",

    "button.background": "#f890e7",
    "button.foreground": "#0c0d12",
    "button.hoverBackground": "#faaeef",
    "button.secondaryBackground": "#20222e",
    "button.secondaryForeground": "#ececee",
    "badge.background": "#f890e7",
    "badge.foreground": "#0c0d12",
    "progressBar.background": "#f890e7",

    "input.background": "#0c0d12",
    "input.border": "#2a2d3a",
    "input.foreground": "#ececee",
    "input.placeholderForeground": "#7a7a85",
    "inputOption.activeBorder": "#0bd3d3",
    "focusBorder": "#0bd3d3",
    "dropdown.background": "#0c0d12",
    "dropdown.border": "#2a2d3a",

    "textLink.foreground": "#f890e7",
    "textLink.activeForeground": "#faaeef",
    "peekViewEditor.background": "#0c0d12",
    "peekViewResult.background": "#12131a",

    "gitDecoration.modifiedResourceForeground": "#ffcf6a",
    "gitDecoration.deletedResourceForeground": "#ff5470",
    "gitDecoration.untrackedResourceForeground": "#33e59b",
    "gitDecoration.ignoredResourceForeground": "#5a5a66",
    "gitDecoration.conflictingResourceForeground": "#7a5cff",

    "minimap.selectionHighlight": "#f890e7",
    "scrollbarSlider.background": "#2a2d3a88",
    "scrollbarSlider.hoverBackground": "#3a3e4eaa",
    "scrollbarSlider.activeBackground": "#f890e766",
    "widget.shadow": "#00000066",
    "selection.background": "#f890e755"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#7a7a85", "fontStyle": "italic" } },
    { "scope": ["string", "string.quoted", "punctuation.definition.string"], "settings": { "foreground": "#33e59b" } },
    { "scope": ["constant.character.escape", "string.regexp"], "settings": { "foreground": "#5ee6e6" } },
    { "scope": ["constant.numeric", "constant.language", "keyword.other.unit"], "settings": { "foreground": "#ffcf6a" } },
    { "scope": ["keyword", "keyword.control", "storage", "storage.type", "storage.modifier"], "settings": { "foreground": "#f890e7" } },
    { "scope": ["keyword.operator"], "settings": { "foreground": "#b4b4be" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call"], "settings": { "foreground": "#0bd3d3" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.class", "support.type", "entity.other.inherited-class"], "settings": { "foreground": "#7a5cff" } },
    { "scope": ["variable", "variable.other", "meta.definition.variable"], "settings": { "foreground": "#ececee" } },
    { "scope": ["variable.parameter"], "settings": { "foreground": "#cfcfd6" } },
    { "scope": ["variable.other.property", "support.variable.property", "meta.object-literal.key"], "settings": { "foreground": "#a6f4f4" } },
    { "scope": ["entity.name.tag", "punctuation.definition.tag"], "settings": { "foreground": "#f890e7" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#ffcf6a" } },
    { "scope": ["support.type.property-name.css", "entity.name.tag.css"], "settings": { "foreground": "#0bd3d3" } },
    { "scope": ["markup.heading", "entity.name.section"], "settings": { "foreground": "#f890e7", "fontStyle": "bold" } },
    { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "scope": ["markup.inline.raw", "markup.fenced_code"], "settings": { "foreground": "#33e59b" } },
    { "scope": ["markup.underline.link"], "settings": { "foreground": "#0bd3d3" } },
    { "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#ff5470" } },
    { "scope": ["meta.diff.header", "punctuation.definition.changed"], "settings": { "foreground": "#7a5cff" } }
  ]
}
